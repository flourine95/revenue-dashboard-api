# ------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your machine.
#   cp .env.example .env
# ------------------------------------------------------------------

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://revenue:revenue@localhost:5432/revenue_dashboard?schema=public"

# HTTP server
NODE_ENV=development
PORT=4000

# Origin allowed to call the API (the Next.js app)
CORS_ORIGIN=http://localhost:3000

# How long an admin session stays valid (days)
SESSION_TTL_DAYS=7

# Admin account created by `pnpm db:seed`.
# DEMO ONLY — never reuse these credentials outside local development.
SEED_ADMIN_EMAIL=admin@revenue.local
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_NAME=Admin
