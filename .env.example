# Copy to .env: cp .env.example .env

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://revenue:revenue@localhost:5432/revenue_dashboard?schema=public"

# HTTP server
NODE_ENV=development
PORT=4000

# Frontend origin allowed in CORS
CORS_ORIGIN=http://localhost:3000

# Admin session lifetime (days)
SESSION_TTL_DAYS=7

# Demo admin created by `pnpm db:seed` — never reuse outside local dev.
SEED_ADMIN_EMAIL=admin@revenue.local
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_NAME=Admin
