# Copy to .env: cp .env.example .env

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://revenue:revenue@localhost:5432/revenue_dashboard?schema=public"

# HTTP server
NODE_ENV=development
PORT=4000

# Frontend origin allowed in CORS
CORS_ORIGIN=http://localhost:3000

# Admin session lifetime (days)
SESSION_TTL_DAYS=7

# Failed login attempts allowed per client before a temporary lockout
LOGIN_MAX_ATTEMPTS=5
# Length of the login attempt window, in minutes
LOGIN_WINDOW_MINUTES=15

# Weekly revenue budget exposed in GET /api/dashboard (budget.weeklyRevenue)
BUDGET_WEEKLY_REVENUE=20000

# Demo admin created by `pnpm db:seed` — never reuse outside local dev.
SEED_ADMIN_EMAIL=admin@revenue.local
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_NAME=Admin
