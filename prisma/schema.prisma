// Revenue dashboard data model.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Admin user that can sign in and manage dashboard data.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  @@map("users")
}

/// Server-side admin session (opaque token, stored hashed).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

/// One row per calendar day with the restaurant's operational metrics.
model DailyMetric {
  id             String   @id @default(cuid())
  date           DateTime @unique @db.Date
  posRevenue     Decimal  @map("pos_revenue") @db.Decimal(12, 2)
  eatclubRevenue Decimal  @map("eatclub_revenue") @db.Decimal(12, 2)
  labourCost     Decimal  @map("labour_cost") @db.Decimal(12, 2)
  covers         Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("daily_metrics")
}

/// Positive or negative event rendered as an annotation on the dashboard chart.
model Event {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date
  type        EventType
  title       String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([date])
  @@map("events")
}

enum EventType {
  positive
  negative
}
